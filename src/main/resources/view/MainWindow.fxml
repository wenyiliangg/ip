<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="560.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="toothless.ui.MainWindow">
    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <top>
                <VBox spacing="4.0" styleClass="app-header">
                    <padding>
                        <Insets bottom="15.0" left="22.0" right="22.0" top="17.0" />
                    </padding>
                    <children>
                        <Label styleClass="app-title" text="TOOTHLESS" />
                        <Label styleClass="app-subtitle" text="Your tiny task-taming companion" />
                    </children>
                </VBox>
            </top>
            <center>
                <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                            pannable="true" styleClass="conversation-scroll">
                    <content>
                        <VBox fx:id="dialogContainer" fillWidth="true" spacing="13.0"
                              styleClass="conversation">
                            <padding>
                                <Insets bottom="18.0" left="16.0" right="16.0" top="18.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>
            </center>
            <bottom>
                <HBox alignment="CENTER" spacing="10.0" styleClass="composer">
                    <padding>
                        <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                    </padding>
                    <children>
                        <TextField fx:id="userInput" HBox.hgrow="ALWAYS"
                                   onAction="#handleUserInput"
                                   promptText="Tell Toothless what you need..." />
                        <Button fx:id="sendButton" defaultButton="true"
                                onAction="#handleUserInput" text="Send" />
                    </children>
                </HBox>
            </bottom>
        </BorderPane>
    </children>
</AnchorPane>
