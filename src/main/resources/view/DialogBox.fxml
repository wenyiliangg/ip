<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" maxWidth="1.7976931348623157E308" spacing="10.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
    </padding>
    <children>
        <Label fx:id="dialog" maxWidth="360.0" minHeight="-Infinity"
               styleClass="dialog-bubble" wrapText="true" />
        <ImageView fx:id="displayPicture" fitHeight="54.0" fitWidth="54.0"
                   pickOnBounds="true" preserveRatio="true" />
    </children>
</fx:root>
